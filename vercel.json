{
  "version": 2,
  "name": "nullvoid",
  "builds": [{ "src": "index.html", "use": "@vercel/static" }],
  "routes": [{ "src": "/(.*)", "dest": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(self), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy",   "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' wss://*.peerjs.com https://*.peerjs.com wss://0.peerjs.com https://0.peerjs.com; media-src 'self' blob:;" },
        { "key": "Cache-Control",             "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
